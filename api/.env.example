PORT=3001
BASE_URL=http://localhost:3001
DATABASE_URL=postgres://snip:snip@localhost:5432/snip
REDIS_URL=redis://localhost:6379

# Postgres pool (see src/config.js for sizing rationale)
PG_POOL_MAX=10
PG_POOL_MIN=0
PG_IDLE_TIMEOUT_MS=30000
PG_CONN_TIMEOUT_MS=5000

# Cache
SLUG_TTL_SECONDS=3600

# AIR benchmark harness (leave unset in production — the /__air support
# routes are not registered unless AIR_BENCHMARK_MODE=1).
# AIR_BENCHMARK_MODE=1
# AIR_BENCHMARK_TOKEN=change-me
