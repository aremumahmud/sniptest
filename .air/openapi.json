{
  "openapi": "3.0.3",
  "info": {
    "title": "Snip API",
    "version": "1.0.0",
    "description": "URL shortener. Creates short links, resolves slugs (hot path), and serves click stats."
  },
  "servers": [{ "url": "http://localhost:3001", "description": "Local API" }],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "Liveness probe (pings Postgres + Redis).",
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                },
                "example": { "status": "ok" }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "error": { "type": "string" }
                  }
                },
                "example": { "status": "degraded", "error": "connect ECONNREFUSED" }
              }
            }
          }
        }
      }
    },
    "/links": {
      "post": {
        "operationId": "createLink",
        "summary": "Create a short link.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Target http(s) URL to shorten."
                  },
                  "userId": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Optional owner user id."
                  },
                  "slug": {
                    "type": "string",
                    "description": "Optional custom slug; otherwise generated."
                  }
                }
              },
              "example": { "url": "https://example.com/very/long/path" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Link" },
                "example": {
                  "id": 1,
                  "user_id": null,
                  "slug": "abc1234",
                  "target_url": "https://example.com/very/long/path",
                  "created_at": "2026-01-01T12:00:00.000Z",
                  "shortUrl": "http://localhost:3001/abc1234"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing url",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "A valid http(s) `url` is required." }
              }
            }
          },
          "409": {
            "description": "Custom slug already taken",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "That custom slug is already taken." }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listLinks",
        "summary": "List links, most recent first.",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Filter by owner user id.",
            "example": 42
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "example": 50
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 0 },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "A page of links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "links": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Link" }
                    },
                    "limit": { "type": "integer" },
                    "offset": { "type": "integer" }
                  }
                },
                "example": {
                  "links": [
                    {
                      "id": 1,
                      "user_id": null,
                      "slug": "abc1234",
                      "target_url": "https://example.com",
                      "created_at": "2026-01-01T12:00:00.000Z",
                      "shortUrl": "http://localhost:3001/abc1234"
                    }
                  ],
                  "limit": 50,
                  "offset": 0
                }
              }
            }
          }
        }
      }
    },
    "/links/{id}/stats": {
      "get": {
        "operationId": "getLinkStats",
        "summary": "Total and per-day click counts for a link.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Link id.",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "link": { "$ref": "#/components/schemas/Link" },
                    "totalClicks": { "type": "integer" },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "day": { "type": "string", "format": "date" },
                          "clicks": { "type": "integer" }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "link": {
                    "id": 1,
                    "slug": "abc1234",
                    "target_url": "https://example.com",
                    "created_at": "2026-01-01T12:00:00.000Z"
                  },
                  "totalClicks": 128,
                  "daily": [{ "day": "2026-01-02", "clicks": 37 }]
                }
              }
            }
          },
          "404": {
            "description": "Link not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Link not found." }
              }
            }
          }
        }
      }
    },
    "/{slug}": {
      "get": {
        "operationId": "resolveSlug",
        "summary": "Hot path: resolve a slug, record a click, and 302-redirect.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Short-link slug.",
            "example": "abc1234"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the target URL",
            "headers": {
              "Location": {
                "schema": { "type": "string", "format": "uri" },
                "description": "The link's target URL.",
                "example": "https://example.com/very/long/path"
              }
            }
          },
          "404": {
            "description": "Unknown slug",
            "content": {
              "text/plain": { "schema": { "type": "string" }, "example": "Not found" }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Link": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "user_id": { "type": "integer", "nullable": true },
          "slug": { "type": "string" },
          "target_url": { "type": "string", "format": "uri" },
          "created_at": { "type": "string", "format": "date-time" },
          "shortUrl": { "type": "string", "format": "uri" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
